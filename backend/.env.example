# Servidor
PORT=3000
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=estilo_confort

# JWT
JWT_ACCESS_SECRET=cambia_esta_clave_de_acceso_por_una_larga_y_aleatoria
JWT_REFRESH_SECRET=cambia_esta_clave_de_refresh_por_otra_distinta_y_aleatoria
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (origen del frontend Angular)
CLIENT_ORIGIN=http://localhost:4200

# ---- Semilla del admin inicial (npm run db:seed) ----
# Opcionales. Si se dejan vacíos, db:seed genera una contraseña aleatoria y la
# imprime UNA sola vez. Fíjalos solo para reproducir un ambiente (CI, restauro).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Reseñas de Google en la portada (Places API).
# Sin GOOGLE_PLACES_API_KEY el bloque de reseñas no se muestra y nada falla.
# La llave se usa SOLO desde el backend; restringila por IP del servidor y
# limitala a "Places API (New)" en Google Cloud.
GOOGLE_PLACES_API_KEY=
# Opcional: si se deja vacío se resuelve solo a partir de GOOGLE_PLACE_QUERY.
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=Mueblería Estilo y Confort, Puebla, México

# ---- Correo transaccional (recuperación de contraseña) ----
# Sin RESEND_API_KEY el backend arranca igual y escribe el enlace
# en la consola en vez de enviarlo. Ver backend/src/utils/mailer.js.
# Se envia por la API HTTP de Resend (puerto 443), NO por SMTP: Hetzner filtra
# los puertos SMTP salientes del VPS y la conexion se queda colgada.
# La llave empieza con re_. SMTP_PASS se acepta como nombre alterno.
# Ver backend/src/config/environment.js.
RESEND_API_KEY=
MAIL_FROM="Estilo y Confort <no-responder@send.estiloyconfortm.com>"

# Buzón que recibe los mensajes del formulario público de Contacto.
CONTACT_EMAIL=muebleria@estiloyconfortm.com
