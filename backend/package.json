{
  "name": "estiloyconfort-backend",
  "version": "1.0.0",
  "description": "API REST para Mueblería Estilo y Confort (Node.js + Express + MySQL + JWT)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --test test/**/*.test.js",
    "db:seed": "node src/database/seed.js",
    "db:seed:2026": "node src/database/seed_products_2026.js",
    "db:seed:categories": "node src/database/seed_categories.js",
    "db:migrate:image-urls": "node src/database/migrate_relative_image_urls.js",
    "db:migrate:price-list": "node src/database/migrate_product_list_price.js",
    "db:migrate:order-number-yearly": "node src/database/backfill_order_number_yearly.js",
    "db:remove-melamina-blanca": "node src/database/remove_melamina_blanca.js",
    "db:rename-melamina": "node src/database/rename_melamina_color.js",
    "content:push": "node src/database/push_content_to_env.js",
    "db:schema:fase4": "node src/database/run-schema.js schema_fase4.sql",
    "db:schema:passwords": "node src/database/run-schema.js schema_password_reset.sql",
    "db:schema:quote-requests": "node src/database/run-schema.js schema_quote_requests.sql"
  },
  "keywords": [
    "express",
    "mysql",
    "jwt",
    "muebleria"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.11.5",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.4",
    "stream-json": "^3.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
