# ============================================================
# Variables que consume docker-compose.yml (contraseñas de MySQL).
# Copia este archivo como `.env` EN EL SERVIDOR y rellena los valores.
#
#   cp .env.example .env && nano .env
#
# ⚠️ Nunca subas el `.env` real a git: contiene contraseñas.
# ⚠️ Las contraseñas de aquí deben COINCIDIR con las de .env.production
#    y .env.staging, o el backend no podrá conectarse a su base de datos.
#
# Genera cada contraseña con:  openssl rand -base64 32
# ============================================================

# ---- Base de datos de PRODUCCIÓN ----
PROD_DB_NAME=estilo_confort
PROD_DB_USER=estilo
PROD_DB_PASSWORD=
PROD_DB_ROOT_PASSWORD=

# ---- Base de datos de PREPRODUCCIÓN ----
STAGING_DB_NAME=estilo_confort
STAGING_DB_USER=estilo
STAGING_DB_PASSWORD=
STAGING_DB_ROOT_PASSWORD=
