# ============================================================
# Variables del contenedor backend-staging (el ambiente de pruebas).
# En el servidor:  cp .env.staging.example .env.staging && nano .env.staging
#
# Usa secretos DISTINTOS a los de producción: si alguien que prueba en staging
# obtiene un token, no debe servirle para entrar a producción.
# ============================================================

# ---- Base de datos ----
# DEBEN coincidir con STAGING_DB_* del .env
DB_USER=estilo
DB_PASSWORD=
DB_NAME=estilo_confort

# ---- JWT (distintos a los de producción) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS y enlaces públicos ----
CLIENT_ORIGIN=https://dev.estiloyconfortm.com

# ---- Correo transaccional (recuperación de contraseña) ----
# Sin SMTP_HOST o sin SMTP_PASS el backend arranca igual y escribe el enlace
# en la consola en vez de enviarlo. Ver backend/src/utils/mailer.js.
# SMTP_PASS es la API key de Resend (empieza con re_).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="Estilo y Confort <no-responder@send.estiloyconfortm.com>"

# Buzón que recibe los mensajes del formulario público de Contacto.
CONTACT_EMAIL=muebleria@estiloyconfortm.com
