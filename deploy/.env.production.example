# ============================================================
# Variables del contenedor backend-prod (la API que usan tus clientes).
# En el servidor:  cp .env.production.example .env.production && nano .env.production
#
# NODE_ENV, PORT, DB_HOST y DB_PORT los inyecta docker-compose.yml: no van aquí.
# ============================================================

# ---- Base de datos ----
# DEBEN coincidir con PROD_DB_USER / PROD_DB_PASSWORD / PROD_DB_NAME del .env
DB_USER=estilo
DB_PASSWORD=
DB_NAME=estilo_confort

# ---- JWT ----
# Genera CADA UNO por separado con:  openssl rand -base64 48
# El backend se niega a arrancar en producción si son cortos o de ejemplo.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS y enlaces públicos ----
# El PRIMER dominio se usa para construir los links de cotización y tickets
# que se mandan por WhatsApp, así que va el canónico (sin www) primero.
CLIENT_ORIGIN=https://estiloyconfortm.com,https://www.estiloyconfortm.com

# ---- Correo transaccional (recuperación de contraseña) ----
# Sin RESEND_API_KEY el backend arranca igual y escribe el enlace
# en la consola en vez de enviarlo. Ver backend/src/utils/mailer.js.
# Se envia por la API HTTP de Resend (puerto 443), NO por SMTP: Hetzner filtra
# los puertos SMTP salientes del VPS y la conexion se queda colgada.
# La llave empieza con re_. SMTP_PASS se acepta como nombre alterno.
# Ver backend/src/config/environment.js.
RESEND_API_KEY=
MAIL_FROM="Estilo y Confort <no-responder@send.estiloyconfortm.com>"

# Buzón que recibe los mensajes del formulario público de Contacto.
CONTACT_EMAIL=muebleria@estiloyconfortm.com
